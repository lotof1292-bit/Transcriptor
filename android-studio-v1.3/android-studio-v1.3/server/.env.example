# Copia este archivo como .env. No lo incluyas en respaldos ni repositorios.
# Genera un valor con: openssl rand -hex 32
STUDIO_TOKEN=REEMPLAZAR_POR_64_CARACTERES_HEXADECIMALES

STUDIO_TEXT_MODEL=qwen3:4b
STUDIO_ASR_MODEL=small
STUDIO_ASR_DEVICE=cpu
STUDIO_ASR_COMPUTE=int8
STUDIO_CLONE_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
STUDIO_OFFLINE=0

# Ajusta al tamaño real del VPS. Qwen TTS y Whisper requieren memoria adicional.
STUDIO_MEMORY_LIMIT=12G
